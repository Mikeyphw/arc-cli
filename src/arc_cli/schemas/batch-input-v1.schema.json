{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arc.batch-input/v1",
  "title": "Arc machine batch input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operations"
  ],
  "properties": {
    "schema": {
      "const": "arc.batch-input/v1"
    },
    "on_error": {
      "type": "string",
      "enum": [
        "stop",
        "continue"
      ],
      "default": "stop"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "string",
              "pattern": "^[^\\u0000]*$"
            }
          },
          "allow_failure": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}
