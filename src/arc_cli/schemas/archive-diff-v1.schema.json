{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arc.archive-diff/v1",
  "title": "Arc archive diff v1",
  "type": "object",
  "required": ["schema", "schema_version", "left", "right", "equivalence", "changes"],
  "properties": {
    "schema": {"const": "arc.archive-diff/v1"},
    "schema_version": {"const": 1},
    "left": {"$ref": "#/$defs/fingerprintSummary"},
    "right": {"$ref": "#/$defs/fingerprintSummary"},
    "equivalence": {
      "type": "object",
      "required": ["logical", "metadata", "byte_identical", "format_changed", "encoding_only"],
      "properties": {
        "logical": {"type": "boolean"},
        "metadata": {"type": "boolean"},
        "byte_identical": {"type": "boolean"},
        "format_changed": {"type": "boolean"},
        "encoding_only": {
          "type": "boolean",
          "description": "True only when logical content and selected metadata match but encoded archive bytes differ."
        }
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "object",
      "required": ["added", "removed", "type_changed", "content_changed", "metadata_changed", "counts"],
      "properties": {
        "added": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "removed": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "type_changed": {"type": "array", "items": {"$ref": "#/$defs/memberChange"}},
        "content_changed": {"type": "array", "items": {"$ref": "#/$defs/memberChange"}},
        "metadata_changed": {"type": "array", "items": {"$ref": "#/$defs/metadataChange"}},
        "counts": {
          "type": "object",
          "required": ["added", "removed", "type_changed", "content_changed", "metadata_changed"],
          "properties": {
            "added": {"type": "integer", "minimum": 0},
            "removed": {"type": "integer", "minimum": 0},
            "type_changed": {"type": "integer", "minimum": 0},
            "content_changed": {"type": "integer", "minimum": 0},
            "metadata_changed": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "archive": {
      "type": "object",
      "required": ["path", "format", "backend", "bytes", "byte_sha256"],
      "properties": {
        "path": {"type": "string"},
        "format": {"type": "string"},
        "backend": {"type": ["string", "null"]},
        "bytes": {"type": "integer", "minimum": 0},
        "byte_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "fingerprintSummary": {
      "type": "object",
      "required": ["schema", "schema_version", "algorithm", "normalization", "digest", "metadata_digest", "complete", "member_count", "file_count", "total_file_bytes", "archive"],
      "properties": {
        "schema": {"const": "arc.logical-fingerprint/v1"},
        "schema_version": {"const": 1},
        "algorithm": {"const": "sha256"},
        "normalization": {"const": "arc-logical-members-v1"},
        "digest": {"$ref": "#/$defs/sha256"},
        "metadata_digest": {"$ref": "#/$defs/sha256"},
        "complete": {"type": "boolean"},
        "member_count": {"type": "integer", "minimum": 0},
        "file_count": {"type": "integer", "minimum": 0},
        "total_file_bytes": {"type": "integer", "minimum": 0},
        "archive": {"$ref": "#/$defs/archive"},
        "transport": {"type": "string"},
        "staged": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": ["path", "kind", "size", "sha256", "link_target", "mtime"],
      "properties": {
        "path": {"type": "string"},
        "kind": {"type": "string"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "link_target": {"type": ["string", "null"]},
        "mtime": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "memberChange": {
      "type": "object",
      "required": ["path", "left", "right"],
      "properties": {
        "path": {"type": "string"},
        "left": {"$ref": "#/$defs/member"},
        "right": {"$ref": "#/$defs/member"}
      },
      "additionalProperties": false
    },
    "metadataSide": {
      "type": "object",
      "required": ["mtime"],
      "properties": {"mtime": {"type": ["string", "null"]}},
      "additionalProperties": false
    },
    "metadataChange": {
      "type": "object",
      "required": ["path", "left", "right"],
      "properties": {
        "path": {"type": "string"},
        "left": {"$ref": "#/$defs/metadataSide"},
        "right": {"$ref": "#/$defs/metadataSide"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
