{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arc.diagnostics-bundle/v1",
  "title": "Arc diagnostics bundle result v1",
  "type": "object",
  "required": ["schema", "schema_version", "path", "sha256", "bytes", "files", "archive_contents_included", "network_probe_performed"],
  "properties": {
    "schema": {"const": "arc.diagnostics-bundle/v1"},
    "schema_version": {"const": 1},
    "path": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes": {"type": "integer", "minimum": 0},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[^/]+\\.json$"}
    },
    "archive_contents_included": {"const": false},
    "network_probe_performed": {"const": false}
  },
  "additionalProperties": false
}
