{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arc.split-manifest/v1",
  "title": "Arc split manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "original_name", "byte_length", "checksum", "split", "parts"],
  "properties": {
    "schema": {"const": "arc.split-manifest/v1"},
    "schema_version": {"const": 1},
    "original_name": {"type": "string", "minLength": 1},
    "byte_length": {"type": "integer", "minimum": 0},
    "checksum": {"$ref": "#/$defs/checksum"},
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "value", "digits"],
      "properties": {
        "by": {"enum": ["size", "parts"]},
        "value": {"type": "integer", "minimum": 1},
        "digits": {"type": "integer", "minimum": 1}
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "name", "size", "checksum"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "checksum": {"$ref": "#/$defs/checksum"}
        }
      }
    }
  },
  "$defs": {
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"enum": ["sha256", "sha512", "blake2b"]},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
