{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arc.logical-fingerprint/v1",
  "title": "Arc logical archive fingerprint v1",
  "type": "object",
  "required": ["schema", "schema_version", "algorithm", "normalization", "digest", "metadata_digest", "complete", "member_count", "file_count", "total_file_bytes", "archive"],
  "properties": {
    "schema": {"const": "arc.logical-fingerprint/v1"},
    "schema_version": {"const": 1},
    "algorithm": {"const": "sha256"},
    "normalization": {"const": "arc-logical-members-v1"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metadata_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "complete": {"type": "boolean"},
    "member_count": {"type": "integer", "minimum": 0},
    "file_count": {"type": "integer", "minimum": 0},
    "total_file_bytes": {"type": "integer", "minimum": 0},
    "archive": {
      "type": "object",
      "required": ["path", "format", "bytes", "byte_sha256"],
      "properties": {
        "path": {"type": "string"},
        "format": {"type": "string"},
        "backend": {"type": ["string", "null"]},
        "bytes": {"type": "integer", "minimum": 0},
        "byte_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "size", "sha256", "link_target", "mtime"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"type": "string"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "link_target": {"type": ["string", "null"]},
          "mtime": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
